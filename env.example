# Copy to .env (never commit .env). Used by docker-compose.yml.

POSTGRES_PASSWORD=change-me-to-a-long-random-string

# development | production. In production the backend REFUSES to start unless everything below is real.
MAUMART_ENV=development

# Browser origin(s) of the Flet web client, comma-separated. No "*" in production.
MAUMART_ALLOWED_ORIGINS=http://localhost:8551
MAUMART_APP_URL=http://localhost:8551

# Email: "console" logs messages (dev only -- it logs reset codes!). Production needs "smtp".
MAUMART_NOTIFY_BACKEND=console
MAUMART_SMTP_HOST=
MAUMART_SMTP_PORT=587
MAUMART_SMTP_USER=
MAUMART_SMTP_PASSWORD=
MAUMART_SMTP_FROM=no-reply@maumart.ng

# Payments: "true" = mock gateway (moves NO money; dev only). Production needs "false" + a key.
MAUMART_PAYMENT_MOCK=true
MAUMART_PAYSTACK_SECRET_KEY=
# Cash-on-delivery-only pilot in production: keep MOCK=true and set this to 1 (other methods are refused).
MAUMART_PILOT_COD_ONLY=

# Set to 1 once HTTPS is confirmed working end to end.
MAUMART_ENABLE_HSTS=

# Address of your reverse proxy, so rate limiting sees real client IPs.
FORWARDED_ALLOW_IPS=127.0.0.1
